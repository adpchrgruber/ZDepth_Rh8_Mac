<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Select the framework(s) you wish to target.
        Rhino 6: net45
        Rhino 7: net48
        Rhino 8 Windows: net48, net7.0, net7.0-windows, net7.0-windows10.0.22000.0, etc
        Rhino 8 Mac: net7.0, net7.0-macos, net7.0-macos12.0, etc
    -->
    <TargetFrameworks>net7.0;net48</TargetFrameworks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <NoWarn>NU1701;CA1416</NoWarn>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Specifies information for Assembly and Yak -->
    <Version>0.9.0-beta</Version>
    <Title>ZDepth</Title>
    <Authors>adpchrgruber</Authors>
    <Company>adpchrgruber</Company>
    <Description>Depth (z-buffer) pass for Rhino 8: a live Z Depth display mode and a capture command for 8-bit PNG at any size or exact 16-bit PNG / float EXR depth. Works on the Mac, where ShowZBuffer does not.</Description>
    <RepositoryUrl>https://github.com/adpchrgruber/ZDepth</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.0.23304.9001" ExcludeAssets="runtime" />
    <!-- Rhino ships Eto; reference the Rhino 8.0 version so the plug-in loads on any Rhino 8. -->
    <PackageReference Include="Eto.Forms" Version="2.8.3" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- DeflateStream for the PNG writer. -->
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net7.0'">
    <!-- Rhino provides System.Drawing at runtime (RhinoView captures return System.Drawing.Bitmap). -->
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plug-in icon, under the name Properties/AssemblyInfo.cs gives. Generated by tools/make_ui.py. -->
    <EmbeddedResource Include="resources\ZDepth.ico" LogicalName="ZDepth.ico" />
    <!-- Toolbar; Rhino loads <plug-in name>.rui from next to the .rhp. Generated by tools/make_ui.py. -->
    <None Update="resources\ZDepth.rui" Link="ZDepth.rui" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Release builds also produce the Rhino Package Manager package:
    dist/ZDepth-<Version>-rh8_0-any.yak (manifest generated from the properties above).
  -->
  <ItemGroup>
    <YakKeyword Include="depth;zdepth;z-buffer;zbuffer;depth-map;controlnet;render;compositing;display-mode;mac" />
  </ItemGroup>

  <Target Name="BuildYakPackage" AfterTargets="DispatchToInnerBuilds" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <YakExecutable Condition="'$(YakExecutable)' == '' and $([MSBuild]::IsOSPlatform(windows)) and Exists('C:\Program Files\Rhino 8\System\Yak.exe')">C:\Program Files\Rhino 8\System\Yak.exe</YakExecutable>
      <YakExecutable Condition="'$(YakExecutable)' == '' and $([MSBuild]::IsOSPlatform(osx)) and Exists('/Applications/Rhino 8.app/Contents/Resources/bin/yak')">/Applications/Rhino 8.app/Contents/Resources/bin/yak</YakExecutable>
      <DistDir>$(MSBuildProjectDirectory)/dist</DistDir>
    </PropertyGroup>

    <Warning Text="Could not find Rhino 8's yak executable; skipping the .yak package." Condition="'$(YakExecutable)' == ''" />

    <ItemGroup>
      <ManifestLine Include="name: $(Title)" />
      <ManifestLine Include="version: $(Version)" />
      <ManifestLine Include="authors:" />
      <ManifestLine Include="- $(Authors)" />
      <ManifestLine Include="description: &quot;$(Description)&quot;" />
      <ManifestLine Include="url: $(RepositoryUrl)" />
      <ManifestLine Include="icon: icon.png" />
      <ManifestLine Include="keywords:" />
      <ManifestLine Include="@(YakKeyword->'- %(Identity)')" />
      <OldYak Include="$(DistDir)/*.yak" />
    </ItemGroup>

    <Copy SourceFiles="$(OutputPath)net48/$(AssemblyName).rhp;$(OutputPath)net48/$(AssemblyName).rui" DestinationFolder="$(DistDir)/net48" />
    <Copy SourceFiles="$(OutputPath)net7.0/$(AssemblyName).rhp;$(OutputPath)net7.0/$(AssemblyName).rui" DestinationFolder="$(DistDir)/net7.0" />
    <WriteLinesToFile File="$(DistDir)/manifest.yml" Lines="@(ManifestLine)" Overwrite="true" />
    <Delete Files="@(OldYak)" Condition="'$(YakExecutable)' != ''" />
    <Exec Command="&quot;$(YakExecutable)&quot; build --platform any" WorkingDirectory="$(DistDir)" Condition="'$(YakExecutable)' != ''" />
  </Target>

</Project>
